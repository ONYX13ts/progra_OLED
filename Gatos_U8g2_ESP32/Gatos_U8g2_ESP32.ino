const size_t NUM_FRAMES = sizeof(frames) / sizeof(frames[0]);
const uint32_t FRAME_INTERVAL_MS = 92;

void setup() {
  oled.setI2CAddress(0x3C << 1);
  oled.begin();
  oled.setPowerSave(0);
  oled.setContrast(255);
}

void loop() {
  static size_t frameIdx = 0;
  const uint32_t inicio = millis();
  oled.clearBuffer();
  oled.drawXBMP(0, 0, 128, 64, frames[frameIdx]);
